{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "twyn/carousel-navigation-arrows",
	"version": "0.1.0",
	"title": "Twyn Navigationspfeile",
	"category": "widgets",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"supports": {
		"html": false,
		"default": {
			"type": "flex"
		}
	},
	"attributes": {
		"prevButtonText": {
			"type": "string",
			"default": "Vorherige"
		},
		"nextButtonText": {
			"type": "string",
			"default": "Nächste"
		},
		"hideButtonText": {
			"type": "boolean",
			"default": false
		}
	},
	"parent": ["twyn/carousel", "twyn/carousel-group"],
	"textdomain": "twyn-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
